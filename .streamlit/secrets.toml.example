# 이 파일을 복사해서 .streamlit/secrets.toml 로 저장하고 값을 채우세요. (secrets.toml 은 절대 깃허브에 올리지 마세요)
# Streamlit Cloud 에서는 앱 설정(Settings) > Secrets 칸에 아래 내용을 그대로 붙여 넣습니다.

[app]
storage = "google"                 # "google" 또는 "local"(시험용)
teacher_id = "teacher"             # 교사 로그인 아이디
teacher_password = "여기에-처음-비밀번호"   # 처음 한 번만 쓰임. 로그인 후 '내 정보'에서 바꾸세요
spreadsheet_id = "구글시트-주소의-/d/ 와 /edit 사이 문자열"
drive_folder_id = ""               # 공유 드라이브 폴더를 쓸 때만. 개인 지메일(OAuth)은 비워 두면 앱이 폴더를 만듭니다

# 구글 클라우드에서 만든 서비스 계정 JSON 키의 내용을 그대로 옮겨 적습니다.
[gcp_service_account]
type = "service_account"
project_id = ""
private_key_id = ""
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = ""
client_id = ""
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = ""

# 개인 지메일 드라이브에 파일을 저장할 때 필요 (README 의 '방법 B' 참고)
# 학교 구글 워크스페이스의 '공유 드라이브'를 쓴다면 이 부분은 지우세요.
[gdrive_oauth]
client_id = ""
client_secret = ""
refresh_token = ""
