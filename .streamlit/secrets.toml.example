# 이 내용을 Streamlit Cloud 앱의 Settings > Secrets 칸에 붙여 넣고 값을 채우세요.
# (내 컴퓨터에서 쓸 때는 .streamlit/secrets.toml 로 저장. 이 파일은 깃허브에 올라가지 않아요)

[app]
storage = "github"                 # "github" 또는 "local"(시험용, 재시작하면 데이터 사라짐)
teacher_id = "teacher"             # 교사 로그인 아이디
teacher_password = "처음-쓸-비밀번호"  # 처음 한 번만 쓰임. 로그인 후 '내 정보'에서 바꾸세요

[github]
token = "github_pat_로-시작하는-토큰"
repo = "내깃허브아이디/class-dashboard-data"   # 데이터용 '비공개' 저장소
branch = "main"
