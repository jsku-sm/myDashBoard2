# 기존 Secrets를 교체하지 말고 필요한 항목만 확인하세요.
# 이 파일에는 실제 비밀값이 없습니다. 값은 배포 Settings > Secrets에서 입력합니다.
# repo와 branch는 사용자가 확인한 기존 운영 데이터 저장 위치입니다.
# token의 빈 값은 자리표시자입니다. 기존 Secrets의 실제 토큰을 유지하세요.

[github]
repo = "jsku-sm/class-dashboard-data"
branch = "main" # 기존 데이터 브랜치를 유지합니다.
token = ""      # 해당 비공개 저장소 Contents Read and write 권한

[classroom]
# 기본값입니다. 이 항목을 생략해도 추가 키 없이 JSON으로 저장합니다.
storage_format = "json"
# 새 기록: data/classroom/v2/ 아래 JSON. 첨부는 base64이며 내용 암호화는 없습니다.
# 저장소 접근 권한자는 답안·평가·첨부를 읽을 수 있습니다.
# 클래스룸용 encryption_key, ENCRYPTION_KEY, 소노클 설정은 필요하지 않습니다.
# 독립 소노클 등 다른 기능에 필요한 기존 Secrets는 삭제하거나 변경하지 마세요.

# 기존 data/classroom/v1/ 암호문에 접근할 때만 위 storage_format을 "encrypted"로
# 바꾸고 처음 저장할 때 사용한 원래 키를 아래에 설정합니다. 새 키를 만들지 않습니다.
# encryption_key = ""
# CLASSROOM_ENCRYPTION_KEY 또는 기존 ENCRYPTION_KEY도 지원합니다.
# 기존 비밀키가 있어도 storage_format을 생략하면 JSON 모드를 사용합니다.
# 기존 암호문을 자동으로 읽거나 JSON으로 이전·덮어쓰지 않습니다.
# 키 원문은 배포 Secrets에만 입력하세요. 실제 값을 코드·ZIP·채팅에 넣지 않습니다.

# 교사 계정이 아직 한 명도 없을 때만 기존 [app] 설정에 다음을 채웁니다.
# 기존 계정이 있으면 비밀번호 해시를 다시 만들거나 초기화하지 않습니다.
# [app]
# storage = "github"
# teacher_id = ""
# teacher_password = ""  # 10자 이상, 채팅·코드·GitHub에 넣지 않습니다.
