+def mission_progress(user,mid):
+    """Submission and learning status for each student targeted by one mission (author teacher only)."""
+    b=db._ready_backend()
+    with b.lock:
+        u=_actor(user,b,"teacher");m=_mission(b,mid)
+        if m["owner_id"]!=u["id"]:raise PermissionError("미션 작성 교사만 제출 상태를 볼 수 있습니다.")
+        accounts={r["id"]:r for r in b.read("users")}
+        profiles={r["student_id"]:r for r in b.read("game_profiles")}
+        rows=[]
+        for t in _load(m["targets_json"],[]):
+            account=accounts.get(t["id"],{})
+            row=profiles.get(t["id"])
+            session=None
+            if row:
+                session=next((s for s in _load(row["state_json"],engine.new_profile())["sessions"] if s.get("mission_id")==mid),None)
+            reassigned=account.get("class",t.get("class"))!=t.get("class")
+            if reassigned:state="reassigned"
+            elif session is None:state="not_started"
+            elif session["status"]=="done":state="done"
+            elif session["status"]=="paused":state="paused"
+            else:state="working"
+            info=engine.summarize(session) if session else None
+            rows.append({"id":t["id"],"name":account.get("name",t.get("name","")),"class":t.get("class",""),"state":state,"info":info})
+        return dict(id=m["id"],title=m["title"],topic_id=m["topic_id"],active=m["active"]=="1",rows=rows)
+
