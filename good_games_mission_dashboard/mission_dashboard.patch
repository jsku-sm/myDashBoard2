+def _mission_row(r,active):
+    info=r["info"]
+    state="시작 마감 · 미시작" if r["state"]=="not_started" and not active else STATE_LABEL[r["state"]]
+    base={"학생":r["name"],"학급":r["class"],"상태":state}
+    if info is None:
+        return {**base,"현재 학습":"—","진행":"0/5","제출":"0/5","정답":"0/5","오답 제출":0,"힌트·해설":"0 · 0","마지막 활동":"—"}
+    if r["state"]=="reassigned":now="학급 변경으로 중단"
+    elif r["state"]=="done":now="5문항 완료"
+    else:now=f"{info['index']+1}번 문항 · {engine.MODES[info['mode']]}"
+    return {**base,"현재 학습":now,"진행":f"{info['index']}/5","제출":f"{info['submitted']}/5","정답":f"{info['solved']}/5",
+            "오답 제출":info["wrong"],"힌트·해설":f"{info['hints']} · {info['revealed']}",
+            "마지막 활동":info["updated_at"].split(".")[0].replace("T"," ")}
+
+
+def _mission_dashboard(user,mid,active=True):
+    data=svc.mission_progress(user,mid)
+    rows=sorted(data["rows"],key=lambda r:(r["class"],r["name"]))
+    if not rows:st.info("이 미션의 대상 학생이 없습니다.");return
+    def count(*states):return sum(r["state"] in states for r in rows)
+    c=st.columns(4)
+    c[0].metric("완료",count("done"))
+    c[1].metric("진행 중",count("working","paused"))
+    c[2].metric("아직 시작 안 함",count("not_started"))
+    c[3].metric("배정 변경",count("reassigned"))
+    st.dataframe([_mission_row(r,active) for r in rows],hide_index=True,width="stretch")
+    st.caption("제출 = ‘내 생각 확인하기’를 누른 문항 수 · 정답 = 맞힌 문항 수 · 진행 = 완료한 문항 수. 학생의 답 내용과 정답 번호는 여기에 표시하지 않습니다.")
