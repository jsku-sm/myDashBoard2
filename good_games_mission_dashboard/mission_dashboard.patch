+def test_mission_progress_reports_submissions_and_states_without_answers(game_env):
+    e=game_env;e.actor(e.t)
+    mid=e.svc.create_mission(e.t,'제출 확인','move.reflection',['1-1','1-2'])
+    sid0=e.start(e.ss[0],mission=mid);e.complete(sid0,e.ss[0])
+    sid1=e.start(e.ss[1],mission=mid);s=engine.active(e.raw(e.ss[1]),sid1);ans=s['questions'][0]['answer']
+    e.action(sid1,'answer',e.ss[1],choice=(ans+1)%4)
+    e.action(sid1,'hint',e.ss[1])
+    e.action(sid1,'answer',e.ss[1],choice=ans)
+    e.action(sid1,'advance',e.ss[1])
+    e.start(e.ss[3],mission=mid)
+    e.b.update('users',e.ss[3]['id'],{'class':'1-1'})
+    e.actor(e.t)
+    data=e.svc.mission_progress(e.t,mid)
+    by={r['id']:r for r in data['rows']}
+    assert len(by)==4 and data['active'] is True and data['title']=='제출 확인'
+    assert by['1001']['state']=='done' and by['1001']['info']['solved']==5 and by['1001']['info']['submitted']==5
+    working=by['1002']['info']
+    assert by['1002']['state']=='working' and working['index']==1 and working['submitted']==1
+    assert working['wrong']==1 and working['solved']==1 and working['hints']==1 and working['revealed']==0
+    assert by['1003']['state']=='not_started' and by['1003']['info'] is None
+    assert by['1004']['state']=='reassigned'
+    allowed={'status','index','mode','updated_at','submitted','solved','wrong','hints','revealed'}
+    assert all(set(r['info'])==allowed for r in data['rows'] if r['info'])
+    e.actor(e.other)
+    with pytest.raises(PermissionError):e.svc.mission_progress(e.other,mid)
+    e.actor(e.ss[0])
+    with pytest.raises(PermissionError):e.svc.mission_progress(e.ss[0],mid)
