+def summarize(s):
+    """Teacher-facing counts for one session. Never returns answer text or keys."""
+    answers=s["answers"]
+    wrong=sum(1 for i,a in enumerate(answers) for c in a["choices"] if c!=s["questions"][i]["answer"])
+    return dict(status=s["status"],index=s["index"],mode=s["mode"],updated_at=s["updated_at"],
+        submitted=sum(1 for a in answers if a["choices"]),
+        solved=sum(1 for a in answers if a["solved"]),
+        wrong=wrong,
+        hints=sum(a["hints"] for a in answers),
+        revealed=sum(1 for a in answers if a["revealed"]))
